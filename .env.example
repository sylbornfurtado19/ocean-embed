# OceanEmbed Operational Environment Variables
# Copy this file to .env and configure as appropriate.
# NEVER commit real credentials or passwords to version control!

# Operating Data Mode: 'synthetic' (default for reproducible SIH demo) or 'real'
OCEAN_DATA_MODE=synthetic

# Runtime Environment: 'development', 'demo', or 'production'
API_ENV=development

# Model Checkpoint Path (relative to project root or absolute)
OCEANEMBED_CHECKPOINT=checkpoints/oceanembed_v2.pt

# Data Ingestion Directories
ARGO_DATA_DIR=data/raw/argo
SATELLITE_DATA_DIR=data/raw/satellite

# Copernicus Marine Environment Monitoring Service (CMEMS) API Credentials (Optional)
# Required only if OCEAN_DATA_MODE=real and downloading live satellite raster products
CMEMS_USERNAME=
CMEMS_PASSWORD=

# FastAPI / Uvicorn Server Runtime
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Security & Networking Configuration
# Comma-separated list of allowed origins (no wildcards in production)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8501,http://127.0.0.1:5173,http://127.0.0.1:3000,http://127.0.0.1:8501
# Comma-separated list of allowed host headers
TRUSTED_HOSTS=localhost,127.0.0.1,testserver,0.0.0.0

# API Documentation Control ('true' in dev, 'false' in prod/demo by default)
ENABLE_DOCS=true

# Optional API Key (leave empty/unset to disable authentication for local demo)
# If set, endpoints require 'X-API-Key: <your_key>' header
API_KEY=

# Resource Limits & Concurrency
MAX_REQUEST_BODY_BYTES=1048576
REQUEST_TIMEOUT_SECONDS=30.0
MAX_CONCURRENT_INFERENCE=4
RATE_LIMIT_PER_MINUTE=60
MAX_ARGO_QUERY_RADIUS_DEG=5.0

