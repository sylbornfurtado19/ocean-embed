# OceanEmbed Operational Environment Variables
# Copy this file to .env and configure as appropriate.
# NEVER commit real credentials or passwords to version control!

# Operating Data Mode: 'synthetic' (default for reproducible SIH demo) or 'real'
OCEAN_DATA_MODE=synthetic

# Model Checkpoint Path (relative to project root or absolute)
OCEANEMBED_CHECKPOINT=checkpoints/oceanembed_v2.pt

# Data Ingestion Directories
ARGO_DATA_DIR=data/raw/argo
SATELLITE_DATA_DIR=data/raw/satellite

# Copernicus Marine Environment Monitoring Service (CMEMS) API Credentials (Optional)
# Required only if OCEAN_DATA_MODE=real and downloading live satellite raster products
CMEMS_USERNAME=your_cmems_username_here
CMEMS_PASSWORD=your_cmems_password_here

# FastAPI / Uvicorn Server Runtime
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
